<Window x:Class="R2Cmd.OverwriteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Confirm Overwrite" Width="420" Height="235"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
    Background="{DynamicResource Brush.Background}"
    Foreground="{DynamicResource Brush.TextPrimary}"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown"
    FocusManager.FocusedElement="{Binding ElementName=btnOverwrite}">

    <Window.Resources>
        <!-- Forces a visible border when navigating with keyboard in custom themes -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtOverwritePrompt" Grid.Row="0"
            TextWrapping="Wrap" TextAlignment="Center"
            VerticalAlignment="Center" FontWeight="Bold" />

        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,0"
            KeyboardNavigation.DirectionalNavigation="Cycle"
            KeyboardNavigation.TabNavigation="Cycle">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Left column: Skip and Skip All -->
            <Button x:Name="btnSkip" Content="Skip" Grid.Row="0" Grid.Column="0" Margin="4"
                Width="110" Height="32"
                Click="BtnSkip_Click" />
            <Button x:Name="btnSkipAll" Content="Skip All" Grid.Row="1" Grid.Column="0" Margin="4"
                Width="110" Height="32"
                Click="BtnSkipAll_Click" />

            <!-- Right column: Overwrite and Overwrite All (in a column) -->
            <Button x:Name="btnOverwrite" Content="Overwrite" Grid.Row="0" Grid.Column="1"
                Margin="4" Width="110" Height="32"
                Click="BtnOverwrite_Click" />
            <Button x:Name="btnOverwriteAll" Content="Overwrite All" Grid.Row="1" Grid.Column="1"
                Margin="4" Width="110" Height="32"
                Click="BtnOverwriteAll_Click" />

        </Grid>
    </Grid>
</Window>
