<Window x:Class="R2Cmd.RenameConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rename Conflict"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    FontFamily="Segoe UI" FontSize="13"
    MinWidth="400" MaxWidth="560"
    Background="{DynamicResource Brush.Background}"
    Foreground="{DynamicResource Brush.TextPrimary}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtMessage"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Brush.TextPrimary}"
            Margin="0,0,0,18" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOverwrite" Content="Overwrite" MinWidth="90" Margin="0,0,8,0"
                Click="BtnOverwrite_Click" />
            <Button x:Name="btnRename" Content="Rename" MinWidth="90" Margin="0,0,8,0"
                Click="BtnRename_Click" IsDefault="True" />
            <Button x:Name="btnCancel" Content="Cancel" MinWidth="90" Click="BtnCancel_Click"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
