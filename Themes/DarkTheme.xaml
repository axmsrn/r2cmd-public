<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Window and Surface Colors -->
    <Color x:Key="Color.Background">#FF252526</Color>
    <Color x:Key="Color.Surface">#FF2D2D30</Color>
    <Color x:Key="Color.SurfaceAlt">#FF333337</Color>

    <!-- Interactive States -->
    <Color x:Key="Color.Hover">#FF3E3E42</Color>
    <Color x:Key="Color.Border">#FF454545</Color>

    <!-- Typography -->
    <Color x:Key="Color.TextPrimary">#FFD4D4D4</Color>
    <Color x:Key="Color.TextSecondary">#FF9B9B9B</Color>
    <Color x:Key="Color.TextDisabled">#FF5F5F5F</Color>

    <!-- Accent Palette -->
    <Color x:Key="Color.Accent">#FF9B9B9B</Color>
    <Color x:Key="Color.AccentHover">#FFD4D4D4</Color>

    <!-- Selection and Cursor States -->
    <Color x:Key="Color.Selection">#FF555555</Color>
    <Color x:Key="Color.SelectionInactive">#FF353538</Color>

    <!-- Marked Files (Insert / Space) -->
    <Color x:Key="Color.MarkedText">#FFE5C07B</Color>

    <!-- ScrollBar Elements -->
    <Color x:Key="Color.ScrollThumb">#FF4A4A4A</Color>
    <Color x:Key="Color.ScrollThumbHover">#FF5E5E5E</Color>

    <!-- Feedback and Status -->
    <Color x:Key="Color.Danger">#FFE5534B</Color>

    <!-- ===================== Terminal ===================== -->
    <!-- Based on the One Half palette (Atom / Sublime). Foreground is a soft grey
         rather than white and the background is a shade off black: the pair sits
         near 10:1, which reads cleanly without the glare of pure black on white. -->
    <Color x:Key="Color.Terminal.Background">#FF1F2126</Color>
    <Color x:Key="Color.Terminal.Foreground">#FFC8CCD4</Color>
    <Color x:Key="Color.Terminal.Cursor">#FF9AA2B1</Color>

    <!-- Standard xterm-256color palette (first 16 colors) -->
    <!-- This matches what Ubuntu/Linux terminals expect for proper mc colors -->
    <Color x:Key="Color.Terminal.Ansi0">#FF000000</Color>
    <Color x:Key="Color.Terminal.Ansi1">#FFCD0000</Color>
    <Color x:Key="Color.Terminal.Ansi2">#FF00CD00</Color>
    <Color x:Key="Color.Terminal.Ansi3">#FFCDCD00</Color>
    <Color x:Key="Color.Terminal.Ansi4">#FF0000EE</Color>
    <Color x:Key="Color.Terminal.Ansi5">#FFCD00CD</Color>
    <Color x:Key="Color.Terminal.Ansi6">#FF00CDCD</Color>
    <Color x:Key="Color.Terminal.Ansi7">#FFE5E5E5</Color>
    <Color x:Key="Color.Terminal.Ansi8">#FF7F7F7F</Color>
    <Color x:Key="Color.Terminal.Ansi9">#FFFF0000</Color>
    <Color x:Key="Color.Terminal.Ansi10">#FF00FF00</Color>
    <Color x:Key="Color.Terminal.Ansi11">#FFFFFF00</Color>
    <Color x:Key="Color.Terminal.Ansi12">#FF5C5CFF</Color>
    <Color x:Key="Color.Terminal.Ansi13">#FFFF00FF</Color>
    <Color x:Key="Color.Terminal.Ansi14">#FF00FFFF</Color>
    <Color x:Key="Color.Terminal.Ansi15">#FFFFFFFF</Color>

    <!-- Dynamic Brush Mapping -->
    <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{DynamicResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{DynamicResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{DynamicResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.SelectionInactive"
        Color="{DynamicResource Color.SelectionInactive}" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{DynamicResource Color.ScrollThumb}" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="{DynamicResource Color.ScrollThumbHover}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.MarkedText" Color="{DynamicResource Color.MarkedText}" />

    <SolidColorBrush x:Key="Brush.Terminal.Background"
        Color="{DynamicResource Color.Terminal.Background}" />
    <SolidColorBrush x:Key="Brush.Terminal.Foreground"
        Color="{DynamicResource Color.Terminal.Foreground}" />
    <SolidColorBrush x:Key="Brush.Terminal.Cursor" Color="{DynamicResource Color.Terminal.Cursor}" />
</ResourceDictionary>
