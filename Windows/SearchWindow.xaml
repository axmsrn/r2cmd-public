<Window x:Class="R2Cmd.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Search Files (Alt+F7)" Width="780" Height="560"
    MinWidth="600" MinHeight="420"
    WindowStartupLocation="CenterOwner"
    FontFamily="Segoe UI" FontSize="{DynamicResource AppFontSize}"
    Background="{DynamicResource Brush.Background}"
    Foreground="{DynamicResource Brush.TextPrimary}"
    PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="{x:Type GridViewColumnHeader}"
            BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border BorderThickness="0,0,1,0"
                            BorderBrush="{DynamicResource Brush.Border}" Padding="6,4">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                HorizontalAlignment="Left" />
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The default check box is a white square that does not belong on a
             dark surface; this keeps it in the application's palette -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                BorderThickness="1"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path x:Name="Tick" Visibility="Collapsed"
                                    Data="M 2,6 L 5,9 L 10,3" StrokeThickness="1.6"
                                    Stroke="{DynamicResource Brush.TextPrimary}"
                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Search for:" VerticalAlignment="Center" Margin="0,0,10,10" Grid.Row="0"
                Grid.Column="0" />

            <!-- IsTextSearchEnabled="False" turns off the intrusive autocomplete -->
            <ComboBox x:Name="cmbMask" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                Margin="0,0,10,10" Padding="4" IsEditable="True"
                IsTextSearchEnabled="False"
                Style="{DynamicResource Theme.ComboBox}" />

            <TextBlock Text="Start from:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"
                Margin="0,0,10,10" />
            <TextBox x:Name="txtPath" Grid.Row="1" Grid.Column="1" Margin="0,0,5,10" Padding="4"
                Style="{DynamicResource Theme.TextBox}" />

            <Button x:Name="btnBrowse" Grid.Row="1" Grid.Column="2" Content="..." Width="30"
                Margin="0,0,10,10"
                Click="BtnBrowse_Click" Cursor="Hand" />

            <TextBlock Text="Containing:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"
                Margin="0,0,10,10" />

            <!-- Changed from TextBox to ComboBox to store the last 10 search terms -->
            <ComboBox x:Name="cmbContains" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                Margin="0,0,10,10" Padding="4" IsEditable="True"
                IsTextSearchEnabled="False"
                ToolTip="Leave empty to search by name only"
                Style="{DynamicResource Theme.ComboBox}" />

            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                <CheckBox x:Name="chkCase" Content="Case sensitive" Margin="0,0,18,0" />
                <CheckBox x:Name="chkRegex" Content="Text is a regular expression" Margin="0,0,18,0" />
                <CheckBox x:Name="chkArchives" Content="Look inside archives"
                    ToolTip="Archives by extension, plus .exe installers already opened as archives" />
            </StackPanel>

            <Button x:Name="btnSearch" Content="Search" Grid.Row="0" Grid.Column="3"
                Grid.RowSpan="4" VerticalAlignment="Top" Height="30"
                IsDefault="True" Click="BtnSearch_Click" Cursor="Hand" />
        </Grid>

        <TextBlock x:Name="txtStatus" Grid.Row="1" Text="Ready." Margin="0,0,0,5"
            Foreground="{DynamicResource Brush.TextSecondary}" />

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <ListView x:Name="lvResults" BorderThickness="0" Background="Transparent"
                MouseDoubleClick="LvResults_MouseDoubleClick" SelectionMode="Single"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"
                        BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="Padding" Value="4,0,4,0" />
                        <Setter Property="MinHeight" Value="{DynamicResource AppRowHeight}" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="220"
                            DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="In Folder" Width="380"
                            DisplayMemberBinding="{Binding FullPath}" />
                        <GridViewColumn Header="Size" Width="90"
                            DisplayMemberBinding="{Binding SizeDisplay}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Changed from Right-aligned StackPanel to a full-width Grid to support left-aligned
        stats -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search Statistics display area -->
            <TextBlock x:Name="txtStats" Grid.Column="0" VerticalAlignment="Center"
                Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                Margin="0,0,10,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Sends every match to the active pane, where they can be copied,
                     moved or deleted as a group -->
                <Button x:Name="btnShowInPanel" Content="Show in panel" Width="130" Padding="5"
                    Margin="0,0,10,0"
                    ToolTip="Put all matches into the active file panel"
                    Click="BtnShowInPanel_Click" Cursor="Hand" />

                <Button x:Name="btnGoTo" Content="Go to file" Width="100" Padding="5"
                    Margin="0,0,10,0"
                    Click="BtnGoTo_Click" Cursor="Hand" />
                <Button Content="Cancel" Width="100" Padding="5" IsCancel="True" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
